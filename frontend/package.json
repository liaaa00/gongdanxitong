{
  "name": "work-order-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:visual": "playwright test e2e/visual-smoke.spec.ts",
    "e2e:smoke": "playwright test e2e/role-menu.spec.ts e2e/import-smoke.spec.ts",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 10",
    "smoke:live": "node scripts/smoke-live.mjs",
    "verify:phase56": "node scripts/verify-phase5-6.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.4.0",
    "@ant-design/pro-components": "^2.7.20",
    "@types/react-window": "^1.8.8",
    "antd": "^5.22.0",
    "axios": "^1.7.9",
    "dayjs": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "react-window": "^2.2.7",
    "reactflow": "^11.11.4",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^29.1.1",
    "less": "^4.2.1",
    "msw": "^2.7.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.11",
    "vitest": "^4.1.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
