# 工单系统前端环境变量（配置参考）
# 复制此文件为 .env 后使用
# 复制命令: cp .env.example .env  或直接复制粘贴重命名

# ============================================
# Mock 开关（三选一或组合）
# ============================================

# 1. VITE_USE_MOCK=true
#    Service 层内置 Mock（开发调试用，无需后端）
#    所有 src/services/*.ts 内置的 isMockMode 路径
# VITE_USE_MOCK=false

# 2. VITE_USE_MSW=true
#    MSW Service Worker 拦截（自动化测试用）
#    需要 public/mockServiceWorker.js
# VITE_USE_MSW=false

# 3. 都关闭（默认）→ 发送真实请求到后端
#    当前默认：都关闭，连真实后端

# ============================================
# API 基础地址 — 两种模式选一种
# ============================================

# ┌──────────────────────────────────────────────────────┐
# │ 模式一：服务器模式（推荐 ★）                          │
# │                                                      │
# │ 前端(Vite)和后端(Node)在同一台服务器上运行。           │
# │ 不设置 VITE_API_BASE_URL（留空）。                    │
# │                                                      │
# │ 请求链路：                                            │
# │   浏览器 → /api/xxx（相对路径，同源）                 │
# │         → Vite proxy (changeOrigin)                  │
# │         → http://localhost:3000（本机后端）           │
# │                                                      │
# │ 优点：无跨域、无硬编码IP、所有人数据互通               │
# │ 同事访问 http://服务器IP:5173 即自动关联服务器后端    │
# └──────────────────────────────────────────────────────┘
# VITE_API_BASE_URL=

# ┌──────────────────────────────────────────────────────┐
# │ 模式二：个人开发机模式                                │
# │                                                      │
# │ 前端在你自己的电脑上跑（npm run dev），               │
# │ 后端在远程服务器上跑。                                │
# │                                                      │
# │ 设置 VITE_API_BASE_URL 指向服务器后端地址。           │
# │                                                      │
# │ 请求链路：                                            │
# │   浏览器 → axios 直连 http://服务器IP:3000/api（跨域）│
# │         → 服务器后端（CORS 已开启）                   │
# │   Vite proxy 同时正常工作，双重保险                   │
# └──────────────────────────────────────────────────────┘
# VITE_API_BASE_URL=http://192.168.26.66:3000

# ============================================
# 推荐配置组合
# ============================================
# 开发调试（无后端）:  VITE_USE_MOCK=true
# 服务器运行（推荐）:  都不设（VITE_API_BASE_URL 留空）
# 个人机联调服务器:    都不设 + VITE_API_BASE_URL=http://服务器IP:3000
