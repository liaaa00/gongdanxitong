### P4 smoke/self-check HTTP script (prepared only; do not execute in this task)
### Usage: VS Code REST Client / JetBrains HTTP Client / Postman import.
### Replace tokens and ids before real execution.

@baseUrl = http://localhost:3000/api
@frontendUrl = http://localhost:5173
@runId = P4-0520-manual

@adminToken = <ADMIN_JWT>
@salesToken = <SALES_JWT>
@nonAdminToken = <NON_ADMIN_JWT>
@backendSupervisorToken = <BACKOFFICE_SUPERVISOR_JWT>
@backendHandlerToken = <BACKOFFICE_HANDLER_JWT>
@sharedOwnerToken = <SHARED_OWNER_JWT>
@fieldManagerToken = <FIELD_MANAGER_OR_NON_ADMIN_JWT>

@workflowId = <WORKFLOW_UUID_AFTER_CREATE>
@workOrderId = <WORK_ORDER_UUID>
@r4WorkOrderId = <PROCESSING_WORK_ORDER_UUID_FOR_R4>
@dispatchedOrderId = <DISPATCHED_ORDER_UUID>
@exportTemplateId = <EXPORT_TEMPLATE_UUID>
@roleIdForTest = <ROLE_UUID_FOR_FIELD_PERMISSION_TEST>

### -----------------------------------------------------------------------------
### 0. Token / role sanity checks
### -----------------------------------------------------------------------------

### admin identity
GET {{baseUrl}}/auth/me
Authorization: Bearer {{adminToken}}

### salesperson identity
GET {{baseUrl}}/auth/me
Authorization: Bearer {{salesToken}}

### non-admin identity
GET {{baseUrl}}/auth/me
Authorization: Bearer {{nonAdminToken}}

### backend handler identity
GET {{baseUrl}}/auth/me
Authorization: Bearer {{backendHandlerToken}}

### shared owner identity
GET {{baseUrl}}/auth/me
Authorization: Bearer {{sharedOwnerToken}}

### -----------------------------------------------------------------------------
### 1. G-18 Field management permission: admin allowed / non-admin denied
### -----------------------------------------------------------------------------

### G18 admin can read fields - EXPECT 200
GET {{baseUrl}}/admin/fields?page=1&pageSize=20
Authorization: Bearer {{adminToken}}

### G18 admin can read field permission matrix - EXPECT 200
GET {{baseUrl}}/admin/field-permissions/matrix
Authorization: Bearer {{adminToken}}

### G18 admin can update test field permission - EXPECT 200/201
POST {{baseUrl}}/admin/field-permissions/batch
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "items": [
    {
      "roleId": "{{roleIdForTest}}",
      "fieldCode": "mobile",
      "scenario": "main",
      "permission": "visible"
    }
  ]
}

### G18 non-admin cannot read fields - EXPECT 403
GET {{baseUrl}}/admin/fields?page=1&pageSize=20
Authorization: Bearer {{nonAdminToken}}

### G18 non-admin cannot read field permission matrix - EXPECT 403
GET {{baseUrl}}/admin/field-permissions/matrix
Authorization: Bearer {{nonAdminToken}}

### G18 non-admin cannot update field permissions - EXPECT 403
POST {{baseUrl}}/admin/field-permissions/batch
Authorization: Bearer {{nonAdminToken}}
Content-Type: application/json

{
  "items": [
    {
      "roleId": "{{roleIdForTest}}",
      "fieldCode": "mobile",
      "scenario": "main",
      "permission": "visible"
    }
  ]
}

### -----------------------------------------------------------------------------
### 2. G-19 Workflow configuration CRUD / publish / guard
### -----------------------------------------------------------------------------

### G19 admin list workflows - EXPECT 200
GET {{baseUrl}}/admin/workflows?page=1&pageSize=20&orderType=onboarding
Authorization: Bearer {{adminToken}}

### G19 non-admin list workflows denied - EXPECT 403
GET {{baseUrl}}/admin/workflows?page=1&pageSize=20&orderType=onboarding
Authorization: Bearer {{nonAdminToken}}

### G19 create draft workflow - EXPECT 201/200; copy returned id to @workflowId
POST {{baseUrl}}/admin/workflows
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "P4入职流程自检-{{runId}}",
  "orderType": "onboarding",
  "description": "P4 smoke workflow; delete after test if needed",
  "definitionJson": {
    "nodes": [
      {
        "id": "start",
        "type": "start",
        "label": "开始",
        "position": { "x": 40, "y": 120 },
        "form_schema": { "visible_fields": [], "editable_fields": [], "action_buttons": ["submit"] }
      },
      {
        "id": "data_entry",
        "type": "process",
        "label": "数据录入-P4",
        "module_code": "data_entry",
        "assignee_role": "data_entry_leader",
        "sla_hours": 24,
        "position": { "x": 260, "y": 40 },
        "form_schema": {
          "visible_fields": ["employee_name", "id_card_no", "mobile"],
          "editable_fields": ["employee_name", "id_card_no", "mobile"],
          "action_buttons": ["complete", "return"]
        }
      },
      {
        "id": "contract",
        "type": "approval",
        "label": "合同签约-P4",
        "module_code": "contract",
        "assignee_role": "labor_contract_member",
        "sla_hours": 48,
        "position": { "x": 260, "y": 190 },
        "form_schema": {
          "visible_fields": ["employee_name", "contract_start_date", "contract_end_date"],
          "editable_fields": ["contract_feedback"],
          "action_buttons": ["complete", "return"]
        }
      },
      {
        "id": "end",
        "type": "end",
        "label": "结束",
        "position": { "x": 540, "y": 120 },
        "form_schema": { "visible_fields": [], "editable_fields": [], "action_buttons": [] }
      }
    ],
    "edges": [
      { "id": "start-data_entry", "source": "start", "target": "data_entry", "condition": "提交后派发" },
      { "id": "data_entry-end", "source": "data_entry", "target": "end", "condition": "录入完成" },
      { "id": "start-contract", "source": "start", "target": "contract", "condition": "需要合同" },
      { "id": "contract-end", "source": "contract", "target": "end", "condition": "签约完成" }
    ]
  }
}

### G19 get workflow detail - EXPECT 200
GET {{baseUrl}}/admin/workflows/{{workflowId}}
Authorization: Bearer {{adminToken}}

### G19 update workflow definition - EXPECT 200
PUT {{baseUrl}}/admin/workflows/{{workflowId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "P4入职流程自检-已编辑-{{runId}}",
  "orderType": "onboarding",
  "description": "Updated by P4 smoke script",
  "definitionJson": {
    "nodes": [
      { "id": "start", "type": "start", "label": "开始", "position": { "x": 40, "y": 120 }, "form_schema": { "visible_fields": [], "editable_fields": [], "action_buttons": ["submit"] } },
      { "id": "data_entry", "type": "process", "label": "数据录入-P4-编辑后", "module_code": "data_entry", "assignee_role": "data_entry_leader", "sla_hours": 12, "position": { "x": 280, "y": 50 }, "form_schema": { "visible_fields": ["employee_name", "id_card_no", "mobile"], "editable_fields": ["mobile"], "action_buttons": ["complete", "return"] } },
      { "id": "end", "type": "end", "label": "结束", "position": { "x": 540, "y": 120 }, "form_schema": { "visible_fields": [], "editable_fields": [], "action_buttons": [] } }
    ],
    "edges": [
      { "id": "start-data_entry", "source": "start", "target": "data_entry", "condition": "提交后派发" },
      { "id": "data_entry-end", "source": "data_entry", "target": "end", "condition": "录入完成" }
    ]
  }
}

