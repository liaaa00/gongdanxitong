# ========== 应用运行环境 ==========
NODE_ENV=production
TZ=Asia/Shanghai
LOG_LEVEL=log

# ========== HTTP 反向代理端口（Nginx 对外端口） ==========
HTTP_PORT=8080

# ========== 监控（默认仅监听本机） ==========
PROMETHEUS_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3001
GRAFANA_ROOT_URL=http://localhost:3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_me_with_a_secure_grafana_password

# ========== PostgreSQL（docker-compose 会创建 postgres 服务） ==========
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ticket_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# 后端完整连接串（兼容外部工具）；NestJS 当前优先读取 DB_*。
DATABASE_URL=postgres://postgres:postgres@postgres:5432/ticket_system
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=ticket_system
DB_SCHEMA=public
DB_LOGGING=false

# ========== JWT 鉴权 ==========
# 生产环境请使用 32 位以上随机字符串，例如：openssl rand -hex 32
JWT_SECRET=replace_me_with_a_secure_random_string_32chars_or_more
JWT_REFRESH_SECRET=replace_me_with_a_refresh_secret_32chars_or_more
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ========== OpenAI 兼容接口（AI 字段映射） ==========
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ========== 文件上传 ==========
# Docker 容器内上传目录，compose 会挂载到 backend_uploads 卷。
UPLOAD_DIR=/app/uploads
MAX_IMPORT_SIZE_MB=10
MAX_ATTACHMENT_SIZE_MB=20
MAX_UPLOAD_SIZE_MB=20
MAX_IMPORT_ROWS=5000

# ========== 密码加密强度 ==========
BCRYPT_ROUNDS=10
BCRYPT_SALT_ROUNDS=10
