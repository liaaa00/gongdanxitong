# Copy values through deploy/Generate-ProductionEnv.ps1. Never commit the generated file.
NODE_ENV=production
TZ=Asia/Shanghai

PUBLIC_HOSTNAME=work-order.example.com
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_BIND_ADDRESS=0.0.0.0
HTTPS_PORT=443
TLS_CERT_FILE=/etc/letsencrypt/live/work-order.example.com/fullchain.pem
TLS_KEY_FILE=/etc/letsencrypt/live/work-order.example.com/privkey.pem

POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ticket_system
POSTGRES_USER=ticket_app
POSTGRES_PASSWORD=replace_with_generated_database_password
DB_SCHEMA=public

REDIS_PASSWORD=replace_with_generated_redis_password
REDIS_KEY_PREFIX=ticket-system:

JWT_SECRET=replace_with_openssl_rand_hex_32_output
JWT_REFRESH_SECRET=replace_with_a_different_openssl_rand_hex_32_output
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

AUTO_SEED=false
DB_LOGGING=false
BCRYPT_ROUNDS=12
BCRYPT_SALT_ROUNDS=12

UPLOAD_DIR=/app/uploads
MAX_IMPORT_SIZE_MB=10
MAX_ATTACHMENT_SIZE_MB=20

AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

PROMETHEUS_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3001
GRAFANA_ROOT_URL=https://work-order.example.com/grafana/
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_generated_grafana_password
