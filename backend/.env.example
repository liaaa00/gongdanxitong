# 本文件只是模板，不是运行口径。
# 本机原生启动（局域网单机）的端口/主机/路径唯一事实源是 config/env.ps1：
#   PostgreSQL 127.0.0.1:5433 / ticket_system，后端 0.0.0.0:3000，前端 0.0.0.0:5173。
# Docker / Nginx 生产形态是另一套命名空间（容器内 postgres:5432、HTTP_PORT=8080），
# 见根目录 .env 与 docker-compose*.yml，不要与本模板混用。
NODE_ENV=development
PORT=3000
TZ=Asia/Shanghai
LOG_LEVEL=log

# PostgreSQL（本地原生启动实测 127.0.0.1:5433；Docker 内请改为主机名 postgres、端口 5432）
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/ticket_system
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=ticket_system
DB_SCHEMA=public
DB_LOGGING=false

# JWT
JWT_SECRET=change-me-jwt-secret-please-use-32chars-or-more
JWT_REFRESH_SECRET=change-me-refresh-secret-please-use-32chars-or-more
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# AI 字段映射（OpenAI 兼容）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# 诊断开关：true 时跳过本地优先优化，强制全表头进入 LLM
AI_FORCE_LLM=false

# 上传
UPLOAD_DIR=uploads
MAX_IMPORT_SIZE_MB=50
MAX_ATTACHMENT_SIZE_MB=20
MAX_UPLOAD_SIZE_MB=20
MAX_IMPORT_ROWS=5000

# 密码加密
BCRYPT_ROUNDS=10
BCRYPT_SALT_ROUNDS=10

# Completion result email delivery (disabled until the public mailbox is confirmed)
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_MAX_ATTEMPTS=3
