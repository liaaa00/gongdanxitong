NODE_ENV=development
PORT=3000
TZ=Asia/Shanghai
LOG_LEVEL=log

# PostgreSQL（本地原生启动默认连接 127.0.0.1；Docker 内请改为 postgres）
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/ticket_system
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=ticket_system
DB_SCHEMA=public
DB_LOGGING=false

# JWT
JWT_SECRET=change-me-jwt-secret-please-use-32chars-or-more
JWT_REFRESH_SECRET=change-me-refresh-secret-please-use-32chars-or-more
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# AI 字段映射（OpenAI 兼容）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# 诊断开关：true 时跳过本地优先优化，强制全表头进入 LLM
AI_FORCE_LLM=false

# 上传
UPLOAD_DIR=uploads
MAX_IMPORT_SIZE_MB=10
MAX_ATTACHMENT_SIZE_MB=20
MAX_UPLOAD_SIZE_MB=20
MAX_IMPORT_ROWS=5000

# 密码加密
BCRYPT_ROUNDS=10
BCRYPT_SALT_ROUNDS=10
