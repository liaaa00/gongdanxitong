{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://workorder-system.local/permission-config.schema.json",
  "title": "Permission Configuration Schema",
  "description": "统一权限配置数据模型",
  "type": "object",
  "required": ["version", "roles", "routePermissions", "fieldPermissions"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^v\d+\.\d+\.\d+$"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "code", "name", "canonicalCode", "isActive"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "code": { "type": "string", "pattern": "^[a-z_]+$" },
          "name": { "type": "string" },
          "canonicalCode": { "type": "string", "pattern": "^[a-z_]+$" },
          "isActive": { "type": "boolean" },
          "description": { "type": "string" }
        }
      }
    },
    "routePermissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "allowedRoles"],
        "properties": {
          "path": { "type": "string" },
          "allowedRoles": { "type": "array", "items": { "type": "string" } },
          "backendActions": { "type": "array", "items": { "type": "string" } },
          "menu": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "icon": { "type": "string" },
              "order": { "type": "integer" },
              "hidden": { "type": "boolean" }
            }
          }
        }
      }
    },
    "fieldPermissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scenario", "roleFieldRules"],
        "properties": {
          "scenario": { "type": "string" },
          "roleFieldRules": {
            "type": "object",
            "patternProperties": {
              "^[a-z_]+$": {
                "type": "object",
                "patternProperties": {
                  "^[a-zA-Z_][a-zA-Z0-9_]*$": {
                    "type": "string",
                    "enum": ["visible", "hidden", "readonly", "masked"]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
